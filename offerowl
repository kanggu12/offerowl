def t(key: str, **kw) -> str:
    """A message of the launcher in the current language"""
    return llm.message(MSG, key, **kw)


def installed(name: str) -> bool:
    """True when the file of a separate program is there"""
    return (ROOT / COMPONENTS[name]).is_file()


def help_text() -> str:
    """The whole command list in plain words, with a marker on commands whose program is not there yet"""
    lines = [t("tagline"), "", t("usage_head"), "       " + t("usage_one"), "", resume.t("commands")]
    for name in ORDER:
        summary = resume.t("cmd_" + name) if name in resume.COMMANDS else t("cmd_" + name)  # three commands are described here, six in resume.py
        tag = "  " + t("not_installed_tag") if name in COMPONENTS and not installed(name) else ""
        lines.append(f"  {name:10} {summary}{tag}")
    lines += ["", t("settings_head"), "  " + t("setting_llm"), "  " + t("setting_llm_default"), "  " + t("setting_lang"), "", t("more")]
    return "\n".join(lines)


def run_component(name: str, rest: list) -> int:
    """Run the program behind a COMPONENTS command, or say it is not installed. It runs inside this process, with
    sys.argv and the module path set as if it had been started directly: a separate process started with -m would put the
    user's current folder first on the module path, and a folder of theirs named src or apps would shadow ours.
    The program's own exit code (sys.exit) passes straight through"""
    rel_path = COMPONENTS[name]
    path = ROOT / rel_path
    if not path.is_file():
        print(t("not_installed", name=name, path=rel_path), file=sys.stderr)  # stderr: stdout stays clean for scripts
        return NOT_INSTALLED_EXIT
    sys.argv = [str(path)] + rest  # what the program sees, exactly as typed
    try:
        if (path.parent / "__init__.py").is_file():  # a package module: run it as one, or its relative imports fail
            sys.path[0:0] = [str(ROOT / "src"), str(ROOT)]  # engine modules by bare name, packages under the root by dotted name
            runpy.run_module(".".join(path.relative_to(ROOT).with_suffix("").parts), run_name="__main__", alter_sys=True)
        else:  # a plain script: its own folder comes first, as when python starts a script
            sys.path[0:0] = [str(path.parent), str(ROOT / "src"), str(ROOT)]
            runpy.run_path(str(path), run_name="__main__")
    except KeyboardInterrupt:  # Ctrl-C: end quietly with the usual code
        return 130
    return 0  # it returned instead of calling sys.exit


def open_panel(rest: list) -> int:
    """`offerowl open [--port N]`: the panel that runs on this PC, however it was started (the app, a container, a
    port-forward or `offerowl panel`), shown in the browser. Its address is printed first, so a computer without a screen
    still has the way in. Exit 1 when no Offerowl panel answers on that port"""
    import argparse  # this command's one option
    import json  # the panel's health answer
    import os  # the port setting
    import urllib.request  # asks the panel
    import open_page  # src/open_page.py: never a terminal browser, never a wait
    ap = argparse.ArgumentParser(prog="offerowl open", description=t("cmd_open"))  # `offerowl open --help`
    ap.add_argument("--port", type=int, default=int(os.environ.get("OFFEROWL_PANEL_PORT") or 8797), help=t("open_port"))  # where it listens
    a = ap.parse_args(rest)  # exits with a usage line on a bad option
    url = f"http://127.0.0.1:{a.port}/"  # the panel answers on this PC only
    direct = urllib.request.build_opener(urllib.request.ProxyHandler({}))  # a proxy setting must not carry a local address away
    try:  # is it Offerowl that answers there
        with direct.open(url + "health", timeout=3) as r:  # the panel's own health answer
            body = json.load(r)  # {"ok": true, "app": "offerowl", ...}
        ours = isinstance(body, dict) and body.get("app") == "offerowl"  # another program on that port is not ours
    except (OSError, ValueError):  # nothing listens, or it is not a JSON answer
        ours = False  # the message below says how to start one
    if not ours:  # nothing to show
        print(t("open_none", port=a.port), file=sys.stderr)  # stderr: stdout stays the address only
        return 1
    print(t("open_at", url=url), flush=True)  # the way in, also with no screen
    open_page.open_page(url)  # the browser, when there is one
    return 0


def main(argv: list | None = None) -> int:
    for stream in (sys.stdout, sys.stderr):  # Korean messages and paths print through any console or redirection, in UTF-8
        if hasattr(stream, "reconfigure"):
            stream.reconfigure(encoding="utf-8", errors="replace")
    os.environ.setdefault("PYTHONIOENCODING", "utf-8")  # and the scripts it starts print the same way
    args = list(sys.argv[1:] if argv is None else argv)  # tests pass their own list
    if args[:1] == ["help"] and len(args) > 1:  # `offerowl help init` means `offerowl init --help`
        args = [args[1], "--help"]
    if not args or args[0] in ("-h", "--help", "help"):
        print(help_text())
        return 0
    name, rest = args[0], args[1:]
    if name in DATA_COMMANDS:  # JSON Resume in and out (src/write_jsonresume.py)
        import write_jsonresume  # noqa: E402  # loaded only when asked, so other commands stay fast
        return write_jsonresume.main([name] + rest)  # the module parses its own arguments
    if name in resume.COMMANDS:  # the six commands that exist as functions
        return resume.main([name] + rest)
    if name == "open":  # a few lines here, no separate program
        return open_panel(rest)
    if name in COMPONENTS:  # the three that arrive later
        return run_component(name, rest)
    guess = difflib.get_close_matches(name, ORDER, n=1)  # a typo is the usual reason for an unknown command
    print(t("unknown", name=name) + (" " + t("did_you_mean", guess=guess[0]) if guess else "") + " " + t("see_help"), file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main())
