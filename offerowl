# -*- coding: utf-8 -*-
"""offerowl: the one command for everything Offerowl does on the command line.

  ./offerowl --help              every command in plain words
  ./offerowl <command> --help    one command

init, ingest, draft, build, selftest and llm live in src/resume.py and are called as functions from here.
cover, interview, panel, api, mcp and doctor are separate programs: this launcher runs one when its file exists and says
"not installed" when it does not. open is here: it finds the panel that runs on this PC and shows it in the browser.
On Windows start it with `python offerowl`.
"""
import difflib  # "did you mean" for a mistyped command
import os  # the encoding the scripts it starts print in
import pathlib  # paths
import runpy  # run a separate program inside this process, as if it had been started directly
import sys  # arguments and the module search path

ROOT = pathlib.Path(__file__).resolve().parent  # repository root; resolve() follows a symlink, so a link on PATH works
sys.path.insert(0, str(ROOT / "src"))  # the modules below live in src/
import llm  # noqa: E402  settings and message lookup (needs the line above)
import resume  # noqa: E402  the commands that already exist

